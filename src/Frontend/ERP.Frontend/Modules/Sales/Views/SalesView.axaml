<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Sales.ViewModels"
             xmlns:sales="using:ERP.Frontend.Modules.Sales"
             xmlns:inv="using:ERP.Frontend.Modules.Inventory"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Sales.Views.SalesView"
             x:DataType="vm:SalesViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="h1" Text="Venta al contado" />
    <controls:FeedbackBar IsBusy="{Binding IsBusy}"
                          ErrorMessage="{Binding ErrorMessage}"
                          SuccessMessage="{Binding SuccessMessage}" />
    <Border Classes="card">
      <StackPanel Spacing="8" IsEnabled="{Binding CanConfirm}">
        <controls:FormField Label="Cliente">
          <controls:FormField.FieldContent>
            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="sales:CustomerItem">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:FormField.FieldContent>
        </controls:FormField>
        <controls:FormField Label="Bodega">
          <controls:FormField.FieldContent>
            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="inv:WarehouseItem">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:FormField.FieldContent>
        </controls:FormField>
        <controls:FormField Label="Producto o servicio">
          <controls:FormField.FieldContent>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="inv:ProductItem">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:FormField.FieldContent>
        </controls:FormField>
        <controls:FormField Label="Cantidad">
          <controls:FormField.FieldContent>
            <TextBox Text="{Binding QuantityText}" AutomationProperties.Name="Cantidad" />
          </controls:FormField.FieldContent>
        </controls:FormField>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Confirmar venta" Command="{Binding ConfirmCommand}"
                  IsEnabled="{Binding CanSubmit}" />
          <Button Content="Nueva venta" Command="{Binding ResetCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding LastSale, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="{Binding LastSale.Number}" />
        <TextBlock Text="{Binding LastSale.Status, StringFormat='Estado: {0}'}" />
        <TextBlock Text="{Binding LastSale.Subtotal, StringFormat='Subtotal: USD {0:0.00}'}" />
        <TextBlock Text="{Binding LastSale.TaxTotal, StringFormat='IVA: USD {0:0.00}'}" />
        <TextBlock Text="{Binding LastSale.Total, StringFormat='Total: USD {0:0.00}'}" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding CanRead}">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="Historial de ventas" />
        <ItemsControl ItemsSource="{Binding Sales}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sales:SaleResponse">
              <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding CustomerName}" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SaleDate}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Total, StringFormat='USD {0:0.00}'}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Anterior" Command="{Binding PreviousSalesPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding SalesPageLabel}" />
          <Button Content="Siguiente" Command="{Binding NextSalesPageCommand}" IsEnabled="{Binding CanGoNext}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
