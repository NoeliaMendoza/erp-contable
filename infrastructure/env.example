# Copiar a infrastructure/.env (ignorado por Git) y cambiar TODOS los valores.
# Solo para PostgreSQL/Redis locales en Docker. Nunca poner aquí credenciales de Neon.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario-local
POSTGRES_PORT=5432
ERP_DB_NAME=erp
ERP_MIGRATOR_PASSWORD=cambiar-migrator-local
ERP_APP_PASSWORD=cambiar-app-local
REDIS_PORT=6379
