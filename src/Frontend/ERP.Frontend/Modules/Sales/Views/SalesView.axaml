<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Sales.ViewModels"
             xmlns:inv="using:ERP.Frontend.Modules.Inventory"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Sales.Views.SalesView"
             x:DataType="vm:SalesViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="h1" Text="Venta al contado" />
    <controls:FeedbackBar IsBusy="{Binding IsBusy}"
                          ErrorMessage="{Binding ErrorMessage}"
                          SuccessMessage="{Binding SuccessMessage}" />
    <Border Classes="card">
      <StackPanel Spacing="8" IsEnabled="{Binding CanConfirm}">
        <controls:FormField Label="Cliente">
          <controls:FormField.FieldContent>
            <TextBox Text="{Binding CustomerName}" AutomationProperties.Name="Cliente" />
          </controls:FormField.FieldContent>
        </controls:FormField>
        <controls:FormField Label="Producto o servicio">
          <controls:FormField.FieldContent>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="inv:ProductItem">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:FormField.FieldContent>
        </controls:FormField>
        <controls:FormField Label="Cantidad">
          <controls:FormField.FieldContent>
            <TextBox Text="{Binding QuantityText}" AutomationProperties.Name="Cantidad" />
          </controls:FormField.FieldContent>
        </controls:FormField>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Confirmar venta" Command="{Binding ConfirmCommand}"
                  IsEnabled="{Binding CanSubmit}" />
          <Button Content="Nueva venta" Command="{Binding ResetCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding LastSale, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="{Binding LastSale.Number}" />
        <TextBlock Text="{Binding LastSale.Status, StringFormat='Estado: {0}'}" />
        <TextBlock Text="{Binding LastSale.Subtotal, StringFormat='Subtotal: USD {0:0.00}'}" />
        <TextBlock Text="{Binding LastSale.TaxTotal, StringFormat='IVA: USD {0:0.00}'}" />
        <TextBlock Text="{Binding LastSale.Total, StringFormat='Total: USD {0:0.00}'}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
