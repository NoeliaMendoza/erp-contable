<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Guía visual común (responsable: Integrante 6). Ver docs/guia-estilo.md.
    REGLA: ninguna vista escribe colores, tamaños de letra o márgenes "a mano";
    se usan estos recursos (Erp*) y las clases de estilo (h1, h2, muted, error, card, primary, sidebar...).
  -->
  <Styles.Resources>
    <!-- Colores -->
    <SolidColorBrush x:Key="ErpPrimaryBrush" Color="#1F5E8C" />
    <SolidColorBrush x:Key="ErpPrimaryDarkBrush" Color="#164769" />
    <SolidColorBrush x:Key="ErpOnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErpSurfaceBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="ErpCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErpBorderBrush" Color="#D9DEE5" />
    <SolidColorBrush x:Key="ErpTextBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="ErpMutedTextBrush" Color="#5B6675" />
    <SolidColorBrush x:Key="ErpSuccessBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="ErpWarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="ErpErrorBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="ErpSidebarBrush" Color="#16324A" />
    <SolidColorBrush x:Key="ErpSidebarTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErpSidebarMutedTextBrush" Color="#B9CCDD" />

    <!-- Espaciado (escala de 4: 4, 8, 12, 16, 24) y forma -->
    <Thickness x:Key="ErpPagePadding">24</Thickness>
    <Thickness x:Key="ErpCardPadding">16</Thickness>
    <x:Double x:Key="ErpSpacingSmall">8</x:Double>
    <x:Double x:Key="ErpSpacingMedium">12</x:Double>
    <x:Double x:Key="ErpSpacingLarge">16</x:Double>
    <CornerRadius x:Key="ErpRadius">8</CornerRadius>

    <!-- Tipografía -->
    <x:Double x:Key="ErpFontSizeTitle">24</x:Double>
    <x:Double x:Key="ErpFontSizeSubtitle">17</x:Double>
    <x:Double x:Key="ErpFontSizeBody">14</x:Double>
    <x:Double x:Key="ErpFontSizeSmall">12</x:Double>
  </Styles.Resources>

  <Style Selector="TextBlock.sidebar-title">
    <Setter Property="Foreground" Value="{StaticResource ErpSidebarTextBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sidebar">
    <Setter Property="Foreground" Value="{StaticResource ErpSidebarTextBrush}" />
  </Style>
  <Style Selector="TextBlock.sidebar-muted">
    <Setter Property="Foreground" Value="{StaticResource ErpSidebarMutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource ErpFontSizeSmall}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{StaticResource ErpFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{StaticResource ErpFontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource ErpMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource ErpErrorBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource ErpCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ErpBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ErpRadius}" />
    <Setter Property="Padding" Value="{StaticResource ErpCardPadding}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource ErpPrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ErpOnPrimaryBrush}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ErpPrimaryDarkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ErpOnPrimaryBrush}" />
  </Style>
</Styles>
