<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.Frontend.Shared.Controls.ConfirmationDialog"
             x:Name="root"
             MinWidth="360">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="{Binding Title, ElementName=root}" />
      <TextBlock Text="{Binding Message, ElementName=root}" TextWrapping="Wrap" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage, ElementName=root}"
                 IsVisible="{Binding ErrorMessage, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy, ElementName=root}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding CancelText, ElementName=root}" Command="{Binding CancelCommand, ElementName=root}" />
        <Button Classes="primary" Content="{Binding ConfirmText, ElementName=root}"
                Command="{Binding ConfirmCommand, ElementName=root}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
