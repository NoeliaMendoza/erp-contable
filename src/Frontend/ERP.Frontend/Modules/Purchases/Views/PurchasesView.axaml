<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Purchases.ViewModels"
             xmlns:pur="using:ERP.Frontend.Modules.Purchases"
             xmlns:inv="using:ERP.Frontend.Modules.Inventory"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Purchases.Views.PurchasesView"
             x:DataType="vm:PurchasesViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadCommand}"
                IsVisible="{Binding CanRead}" />
        <TextBlock Classes="h1" Text="Compras al contado" />
      </DockPanel>

      <controls:FeedbackBar IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}"
                            SuccessMessage="{Binding SuccessMessage}" RetryCommand="{Binding LoadCommand}" />

      <Border Classes="card" IsVisible="{Binding CanRegister}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Registrar compra" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <controls:FormField Grid.Column="0" Label="Proveedor">
              <controls:FormField.FieldContent>
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Proveedor">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="pur:SupplierItem">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </controls:FormField.FieldContent>
            </controls:FormField>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <TextBox Width="100" Text="{Binding QuantityText}" PlaceholderText="Cantidad" AutomationProperties.Name="Cantidad" />
              <TextBox Width="130" Text="{Binding UnitCostText}" PlaceholderText="Costo unitario" AutomationProperties.Name="Costo unitario" />
              <Button Content="Agregar artículo" Command="{Binding AddLineCommand}" />
            </StackPanel>
          </Grid>

          <controls:FormField Label="Artículo">
            <controls:FormField.FieldContent>
              <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Artículo">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="inv:ProductItem">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </controls:FormField.FieldContent>
          </controls:FormField>

          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PurchaseDraftLine">
                <Border Classes="list-row" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding Product.Name}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.####}'}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding LineCost, StringFormat='USD {0:0.00}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Quitar" Command="{Binding $parent[ItemsControl].((vm:PurchasesViewModel)DataContext).RemoveLineCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="h2" Text="{Binding DraftTotal, StringFormat='Total: USD {0:0.00}'}" />
            <Button DockPanel.Dock="Right" Classes="primary" Content="Registrar borrador"
                    Command="{Binding RegisterCommand}" IsEnabled="{Binding CanRegister}" />
          </DockPanel>
          <TextBlock Text="La recepción y el asiento contable se habilitarán cuando esté lista la transacción compartida entre módulos."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding CanRead}">
        <TextBox Grid.Column="0" Text="{Binding Search}" PlaceholderText="Buscar por número o proveedor"
                 AutomationProperties.Name="Buscar compras" />
        <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchNowCommand}" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Purchases}" IsVisible="{Binding CanRead}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pur:PurchaseItem">
            <Border Classes="card" Margin="0,4">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Classes="h2" Text="{Binding Number}" />
                  <TextBlock Text="{Binding SupplierName}" />
                  <TextBlock Text="{Binding PurchaseDate}" />
                  <TextBlock Text="{Binding Status}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Lines.Count, StringFormat='Artículos: {0}'}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="h2" Text="{Binding TotalCost, StringFormat='USD {0:0.00}'}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock IsVisible="{Binding IsEmpty}" Text="No hay compras registradas." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
