<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1515/CA1848/CA1062 producen ruido en una base modular; se revisan en ADR si se reactivan. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1062;CA2007;CA1716;CA1711;CA1724;CA1034;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1822;CA1852;CA1812;CA1849;CA2234;CA1056;CA1054;CA1002;CA2227;CA1031</NoWarn>
    <Company>LCS - Los Commits Suicidas</Company>
    <Product>ERP Contable</Product>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
