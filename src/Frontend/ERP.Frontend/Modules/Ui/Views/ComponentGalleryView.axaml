<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Ui.ViewModels"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Ui.Views.ComponentGalleryView"
             x:DataType="vm:ComponentGalleryViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16">
      <DockPanel>
        <TextBlock Classes="h1" Text="Guía visual" />
        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="Componentes compartidos de desarrollo" VerticalAlignment="Center" />
      </DockPanel>

      <controls:FeedbackBar IsBusy="{Binding IsBusy}"
                            ErrorMessage="{Binding ErrorMessage}"
                            SuccessMessage="{Binding SuccessMessage}"
                            RetryCommand="{Binding SimulateLoadCommand}" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Formulario y validación" />
          <controls:FormField Label="Nombre de ejemplo"
                              Hint="La etiqueta, ayuda y error siguen el mismo patrón en todos los módulos."
                              ErrorMessage="{Binding SampleNameError}">
            <controls:FormField.FieldContent>
              <TextBox Text="{Binding SampleName}" AutomationProperties.Name="Nombre de ejemplo" />
            </controls:FormField.FieldContent>
          </controls:FormField>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
            <Button Classes="secondary" Content="Simular carga" Command="{Binding SimulateLoadCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Búsqueda y paginación" />
          <controls:SearchBox SearchText="{Binding SearchText}"
                              PlaceholderText="Buscar en el módulo"
                              ClearCommand="{Binding ClearSearchCommand}" />
          <controls:PaginationBar CurrentPage="{Binding CurrentPage}"
                                  TotalPages="{Binding TotalPages}"
                                  CanGoPrevious="{Binding CanGoPrevious}"
                                  CanGoNext="{Binding CanGoNext}"
                                  PreviousCommand="{Binding PreviousPageCommand}"
                                  NextCommand="{Binding NextPageCommand}" />
        </StackPanel>
      </Border>

      <controls:EmptyState Title="Estado vacío"
                           Message="Este mensaje orienta al usuario cuando todavía no existen registros."
                           ActionText="Restablecer ejemplo"
                           ActionCommand="{Binding ResetCommand}" />

      <controls:ConfirmationDialog Title="¿Confirmar acción?"
                                   Message="La operación se ejecutará solo después de que el usuario confirme."
                                   ConfirmText="Confirmar"
                                   CancelText="Cancelar"
                                   IsBusy="{Binding IsBusy}"
                                   ErrorMessage="{Binding ErrorMessage}"
                                   ConfirmCommand="{Binding ConfirmCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
      <TextBlock Classes="muted" Text="La galería usa datos locales de ejemplo; no representa persistencia ni permisos de negocio." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
