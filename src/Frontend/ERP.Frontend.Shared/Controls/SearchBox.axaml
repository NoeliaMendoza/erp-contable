<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.Frontend.Shared.Controls.SearchBox"
             x:Name="root">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBox Text="{Binding SearchText, ElementName=root, Mode=TwoWay}"
             PlaceholderText="{Binding PlaceholderText, ElementName=root}"
             AutomationProperties.Name="Buscar" />
    <Button Grid.Column="1"
            Content="Limpiar"
            Command="{Binding ClearCommand, ElementName=root}"
            IsVisible="{Binding ClearCommand, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
