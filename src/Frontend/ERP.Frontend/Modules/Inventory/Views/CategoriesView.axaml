<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Inventory.ViewModels"
             xmlns:inv="using:ERP.Frontend.Modules.Inventory"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Inventory.Views.CategoriesView"
             x:DataType="vm:CategoriesViewModel">
  <StackPanel Spacing="16">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadCommand}" />
      <TextBlock Classes="h1" Text="Categorías" />
    </DockPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Agrupan el catálogo por línea (Papelería, Bebidas, Servicios técnicos…) para buscar y sacar reportes." />

    <controls:FeedbackBar IsBusy="{Binding IsBusy}"
                          ErrorMessage="{Binding ErrorMessage}"
                          SuccessMessage="{Binding SuccessMessage}"
                          RetryCommand="{Binding LoadCommand}" />

    <!-- Formulario -->
    <Border Classes="card" IsVisible="{Binding CanWrite}">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding NewCategoryCommand}" />
          <TextBlock Classes="h2" Text="{Binding FormTitle}" />
        </DockPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <controls:FormField Grid.Column="0" Label="Nombre" ErrorMessage="{Binding NameError}">
            <controls:FormField.FieldContent>
              <TextBox Text="{Binding Name}" PlaceholderText="Papelería" AutomationProperties.Name="Nombre de la categoría" />
            </controls:FormField.FieldContent>
          </controls:FormField>
          <Button Grid.Column="1" Classes="primary" Content="Guardar" Command="{Binding SaveCommand}"
                  VerticalAlignment="Bottom" IsDefault="True" />
        </Grid>
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="El nombre es único en la empresa sin importar mayúsculas: «Papelería» y «PAPELERÍA» son la misma." />
      </StackPanel>
    </Border>

    <!-- Confirmación de activar/desactivar -->
    <controls:ConfirmationDialog IsVisible="{Binding PendingToggle, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Title="Cambiar estado"
                                 Message="{Binding PendingToggle.Name, StringFormat='¿Cambiar el estado de la categoría {0}?'}"
                                 IsBusy="{Binding IsBusy}"
                                 ErrorMessage="{Binding ErrorMessage}"
                                 ConfirmCommand="{Binding ConfirmToggleCommand}"
                                 CancelCommand="{Binding CancelToggleCommand}" />

    <!-- Búsqueda -->
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <controls:SearchBox Grid.Column="0" SearchText="{Binding Search, Mode=TwoWay}"
                          PlaceholderText="Buscar por nombre"
                          ClearCommand="{Binding ClearSearchCommand}" />
      <CheckBox Grid.Column="1" Content="Incluir inactivas" IsChecked="{Binding IncludeInactive}" />
      <Button Grid.Column="2" Content="Buscar" Command="{Binding SearchNowCommand}" />
    </Grid>

    <!-- Listado -->
    <Border Classes="card">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="2*,*,2*">
          <TextBlock Grid.Column="0" Classes="muted" Text="Nombre" />
          <TextBlock Grid.Column="1" Classes="muted" Text="Estado" />
        </Grid>
        <controls:EmptyState IsVisible="{Binding IsEmpty}"
                             Title="No hay categorías"
                             Message="Todavía no hay categorías. Cree la primera con el formulario, por ejemplo Papelería." />
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="inv:CategoryItem">
              <Grid ColumnDefinitions="2*,*,2*" Margin="0,4">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).CanWrite}">
                  <Button Content="Editar" CommandParameter="{Binding}"
                          Command="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).EditCommand}" />
                  <Button Content="Activar / desactivar" CommandParameter="{Binding}"
                          Command="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).AskToggleCommand}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Paginación -->
    <controls:PaginationBar CurrentPage="{Binding Page}"
                            TotalPages="{Binding TotalPages}"
                            CanGoPrevious="{Binding CanGoPrevious}"
                            CanGoNext="{Binding CanGoNext}"
                            PreviousCommand="{Binding PreviousPageCommand}"
                            NextCommand="{Binding NextPageCommand}" />
  </StackPanel>
</UserControl>
