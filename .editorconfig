root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,axaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.cs]
# Organización
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Preferencias de estilo (sugerencias: no rompen el build)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Nomenclatura (ver docs/guia-estilo.md). El orden importa: reglas más específicas primero.
# Interfaces: IAlgo
dotnet_naming_rule.interfaces_i.symbols = interfaces
dotnet_naming_rule.interfaces_i.style = prefix_i
dotnet_naming_rule.interfaces_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

# Tipos, métodos, propiedades y eventos: PascalCase
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# Constantes y campos estáticos de solo lectura: PascalCase
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# Campos privados de instancia: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Parámetros y variables locales: camelCase
dotnet_naming_rule.locals_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_camel.style = camel
dotnet_naming_rule.locals_camel.severity = warning
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case

# Formato de espacios/sangría (lo verifica `dotnet format` en CI)
dotnet_diagnostic.IDE0055.severity = warning

# Reglas de calidad relevantes para un ERP
dotnet_diagnostic.CA2016.severity = warning   # propagar CancellationToken
dotnet_diagnostic.CA1806.severity = warning
dotnet_diagnostic.IDE0005.severity = suggestion

# Código generado (migraciones EF)
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
