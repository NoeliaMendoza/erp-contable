<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.Frontend.Shared.Controls.FeedbackBar"
             x:Name="root">
  <StackPanel Spacing="8">
    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy, ElementName=root}"
                 AutomationProperties.Name="Cargando" />
    <Border Classes="feedback-error"
            IsVisible="{Binding ErrorMessage, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="error" Text="{Binding ErrorMessage, ElementName=root}" TextWrapping="Wrap" />
        <Button Grid.Column="1"
                Content="Reintentar"
                Command="{Binding RetryCommand, ElementName=root}"
                IsVisible="{Binding RetryCommand, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>
    <Border Classes="feedback-success"
            IsVisible="{Binding SuccessMessage, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding SuccessMessage, ElementName=root}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
