<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Inventory.ViewModels"
             xmlns:inv="using:ERP.Frontend.Modules.Inventory"
             x:Class="ERP.Frontend.Modules.Inventory.Views.CategoriesView"
             x:DataType="vm:CategoriesViewModel">
  <StackPanel Spacing="16">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadCommand}" />
      <TextBlock Classes="h1" Text="Categorías" />
    </DockPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Agrupan el catálogo por línea (Papelería, Bebidas, Servicios técnicos…) para buscar y sacar reportes." />

    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Classes="muted" Text="{Binding SuccessMessage}" IsVisible="{Binding SuccessMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Formulario -->
    <Border Classes="card" IsVisible="{Binding CanWrite}">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Limpiar" Command="{Binding NewCategoryCommand}" />
          <TextBlock Classes="h2" Text="{Binding FormTitle}" />
        </DockPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Nombre" />
            <TextBox Text="{Binding Name}" PlaceholderText="Papelería" AutomationProperties.Name="Nombre de la categoría" />
            <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Guardar" Command="{Binding SaveCommand}"
                  VerticalAlignment="Top" Margin="0,22,0,0" IsDefault="True" />
        </Grid>
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="El nombre es único en la empresa sin importar mayúsculas: «Papelería» y «PAPELERÍA» son la misma." />
      </StackPanel>
    </Border>

    <!-- Confirmación de activar/desactivar -->
    <Border Classes="card" IsVisible="{Binding PendingToggle, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancelar" Command="{Binding CancelToggleCommand}" />
          <Button Classes="primary" Content="Confirmar" Command="{Binding ConfirmToggleCommand}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding PendingToggle.Name, StringFormat='¿Cambiar el estado de la categoría {0}?'}" />
      </DockPanel>
    </Border>

    <!-- Búsqueda -->
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" Text="{Binding Search}" PlaceholderText="Buscar por nombre" AutomationProperties.Name="Buscar categorías" />
      <CheckBox Grid.Column="1" Content="Incluir inactivas" IsChecked="{Binding IncludeInactive}" />
      <Button Grid.Column="2" Content="Buscar" Command="{Binding SearchNowCommand}" />
    </Grid>

    <!-- Listado -->
    <Border Classes="card">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,100,260">
          <TextBlock Grid.Column="0" Classes="muted" Text="Nombre" />
          <TextBlock Grid.Column="1" Classes="muted" Text="Estado" />
        </Grid>
        <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                   Text="Todavía no hay categorías. Cree la primera con el formulario, por ejemplo Papelería." />
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="inv:CategoryItem">
              <Grid ColumnDefinitions="*,100,260" Margin="0,4">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).CanWrite}">
                  <Button Content="Editar" CommandParameter="{Binding}"
                          Command="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).EditCommand}" />
                  <Button Content="Activar / desactivar" CommandParameter="{Binding}"
                          Command="{Binding $parent[UserControl].((vm:CategoriesViewModel)DataContext).AskToggleCommand}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Paginación -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Anterior" Command="{Binding PreviousPageCommand}" />
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding PageLabel}" />
      <Button Content="Siguiente" Command="{Binding NextPageCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
