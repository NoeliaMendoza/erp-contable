<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.Frontend.Shared.Controls.FormField"
             x:Name="root">
  <StackPanel Spacing="4">
    <TextBlock Classes="field-label" Text="{Binding Label, ElementName=root}" />
    <TextBlock Classes="muted small"
               Text="{Binding Hint, ElementName=root}"
               IsVisible="{Binding Hint, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ContentPresenter Content="{Binding FieldContent, ElementName=root}" />
    <TextBlock Classes="error small"
               Text="{Binding ErrorMessage, ElementName=root}"
               IsVisible="{Binding ErrorMessage, ElementName=root, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</UserControl>
