<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Platform.ViewModels"
             xmlns:ui="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Platform.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Border Classes="card" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <ui:OrvixLogo Height="44" />
      <TextBlock Classes="muted" Text="ERP contable para tu negocio" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Se abrirá su navegador para ingresar su correo y contraseña de forma segura. Esta aplicación no ve su contraseña." />

      <Button Classes="primary" Content="Iniciar sesión" Command="{Binding SignInCommand}" IsDefault="True"
              IsVisible="{Binding !IsWaitingForBrowser}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              AutomationProperties.Name="Iniciar sesión en el navegador" />

      <StackPanel Spacing="8" IsVisible="{Binding IsWaitingForBrowser}">
        <TextBlock TextWrapping="Wrap"
                   Text="Complete el inicio de sesión en la ventana del navegador. Al terminar, vuelva a esta aplicación." />
        <Button Content="Cancelar" Command="{Binding CancelSignInCommand}" IsCancel="True"
                HorizontalAlignment="Right" AutomationProperties.Name="Cancelar inicio de sesión" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Notice}"
                 IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="muted small" Text="{Binding ApiBaseUrl, StringFormat='API: {0}'}" />
    </StackPanel>
  </Border>
</UserControl>
