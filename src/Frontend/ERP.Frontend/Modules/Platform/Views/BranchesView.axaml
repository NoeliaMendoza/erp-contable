<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Frontend.Modules.Platform.ViewModels"
             xmlns:api="using:ERP.Frontend.Shared.Api"
             xmlns:controls="using:ERP.Frontend.Shared.Controls"
             x:Class="ERP.Frontend.Modules.Platform.Views.BranchesView"
             x:DataType="vm:BranchesViewModel">
  <StackPanel Spacing="16">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadCommand}" />
      <TextBlock Classes="h1" Text="Sucursales" />
    </DockPanel>
    <controls:FeedbackBar IsBusy="{Binding IsBusy}"
                          ErrorMessage="{Binding ErrorMessage}"
                          SuccessMessage="{Binding SuccessMessage}"
                          RetryCommand="{Binding LoadCommand}" />

    <Border Classes="card" IsVisible="{Binding CanManage}">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="Nueva sucursal" />
        <Grid ColumnDefinitions="140,*,200" ColumnSpacing="12">
          <controls:FormField Grid.Column="0" Label="Código" ErrorMessage="{Binding NewCodeError}">
            <controls:FormField.FieldContent>
              <TextBox Text="{Binding NewCode}" AutomationProperties.Name="Código" />
            </controls:FormField.FieldContent>
          </controls:FormField>
          <controls:FormField Grid.Column="1" Label="Nombre" ErrorMessage="{Binding NewNameError}">
            <controls:FormField.FieldContent>
              <TextBox Text="{Binding NewName}" AutomationProperties.Name="Nombre" />
            </controls:FormField.FieldContent>
          </controls:FormField>
          <controls:FormField Grid.Column="2" Label="Ciudad" Hint="Opcional">
            <controls:FormField.FieldContent>
              <TextBox Text="{Binding NewCity}" AutomationProperties.Name="Ciudad" />
            </controls:FormField.FieldContent>
          </controls:FormField>
        </Grid>
        <Button Classes="primary" Content="Crear" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Branches}" IsVisible="{Binding HasBranches}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="api:Branch">
              <Grid ColumnDefinitions="120,*,160" Margin="0,4">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Code}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding City}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:EmptyState Title="No hay sucursales"
                             Message="Registre la primera sucursal o cambie el texto de búsqueda."
                             IsVisible="{Binding IsEmpty}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
