<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.Frontend.Shared.Controls.PaginationBar"
             x:Name="root">
  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
    <Button Content="Anterior"
            Command="{Binding PreviousCommand, ElementName=root}"
            IsEnabled="{Binding CanGoPrevious, ElementName=root}" />
    <TextBlock VerticalAlignment="Center">
      <Run Text="Página " />
      <Run Text="{Binding CurrentPage, ElementName=root}" />
      <Run Text=" de " />
      <Run Text="{Binding TotalPages, ElementName=root}" />
    </TextBlock>
    <Button Content="Siguiente"
            Command="{Binding NextCommand, ElementName=root}"
            IsEnabled="{Binding CanGoNext, ElementName=root}" />
  </StackPanel>
</UserControl>
